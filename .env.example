# Database
DATABASE_URL=postgres://user:pass@host:5432/clientloop

# Public app URL used to generate first-party tracking redirects
APP_URL=https://clientloop.example.com

# Protect the dashboard and campaign-creation API
DASHBOARD_USER=keith
DASHBOARD_PASSWORD=

# SproutGigs
SPROUTGIGS_USER_ID=
SPROUTGIGS_SECRET_KEY=
