SPROUTGIGS_ZONE_ID=int
SPROUTGIGS_SPEED=1000
SPROUTGIGS_TTR=7
SPROUTGIGS_WEBHOOK_SECRET=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
